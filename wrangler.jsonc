{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "webpage",
  "main": "./src/worker.js",
  "compatibility_date": "2026-10-02",
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "SUPABASE_URL": "https://msjtivyjcvxkfcoxakqo.supabase.co"
  },
  "secrets": {
    "required": [
      "SUPABASE_SERVICE_ROLE_KEY"
    ]
  }
}
